+// r2: four trellis states share a bounded 64-bit load; fixed token counts let MSVC
+// keep accumulators in registers. AVX-VNNI fuses integer multiply/add only. Every
+// 32-weight sum fits int32; FP scaling, FMA and final reduction match r1 exactly.
+template <int KB, int M>
+__forceinline __m256i local_tq_group_r2(const long long* tab, const uint8_t* qs, uint64_t wr) {
+    if constexpr (KB == 6 || KB == 7) {
+        constexpr int low = (28 - 4 * M) * KB;
+        constexpr int byte = low / 8 < 4 * KB - 8 ? low / 8 : 4 * KB - 8;
+        constexpr int origin = M == 0 ? (4 * KB - 4) * 8 : byte * 8;
+        uint64_t v = wr;
+        if constexpr (M != 0) std::memcpy(&v, qs + byte, sizeof(v));
+        return rows4(tab, (uint32_t)(v >> ((31-4*M)*KB-origin)) & kTqStateMask,
+                         (uint32_t)(v >> ((30-4*M)*KB-origin)) & kTqStateMask,
+                         (uint32_t)(v >> ((29-4*M)*KB-origin)) & kTqStateMask,
+                         (uint32_t)(v >> ((28-4*M)*KB-origin)) & kTqStateMask);
+    } else {
+        return rows4(tab, tq_state<KB>(qs,wr,4*M), tq_state<KB>(qs,wr,4*M+1),
+                         tq_state<KB>(qs,wr,4*M+2), tq_state<KB>(qs,wr,4*M+3));
+    }
+}
+
+template <int KB, int NT = 0>
+void rows_r2(const int16_t* table, const uint8_t* w, size_t row_bytes, int n, const TqAct* const* a, int nt_dynamic, float* const* out, int r0,
+            int r1) {
+    const int nt = NT > 0 ? NT : nt_dynamic;
+    const int nb = n / 128;
+    constexpr size_t bsz = 2 + 4 * KB;
+    const long long* tab = (const long long*) table;
+    for (int r = r0; r < r1; ++r) {
+        const uint8_t* x = w + (size_t) r * row_bytes;
+        __m128 acc[kTqMaxTokens];
+        for (int t = 0; t < nt; ++t) acc[t] = _mm_setzero_ps();
+        for (int i = 0; i < nb; ++i) {
+            const uint8_t* blk = x + (size_t) i * bsz;
+            const uint8_t* qs = blk + 2;
+            const uint64_t wr = tq_wrap<KB>(qs);
+            __m256i wv[8];   // wv[m] = weights 16m .. 16m+15 (states 4m .. 4m+3)
+#if defined(STRATA_14650HX_4060) && defined(_MSC_VER)
+            wv[0] = local_tq_group_r2<KB, 0>(tab, qs, wr);
+            wv[1] = local_tq_group_r2<KB, 1>(tab, qs, wr);
+            wv[2] = local_tq_group_r2<KB, 2>(tab, qs, wr);
+            wv[3] = local_tq_group_r2<KB, 3>(tab, qs, wr);
+            wv[4] = local_tq_group_r2<KB, 4>(tab, qs, wr);
+            wv[5] = local_tq_group_r2<KB, 5>(tab, qs, wr);
+            wv[6] = local_tq_group_r2<KB, 6>(tab, qs, wr);
+            wv[7] = local_tq_group_r2<KB, 7>(tab, qs, wr);
