 int ExpertPool::phase_tasks(int64_t rows) const {
+#if defined(STRATA_14650HX_4060)
+    // The queue already lets faster workers claim more work. Finer, bounded row ranges
+    // shorten the last E-core/SMT task without changing any row's arithmetic or reductions.
+    // An explicit task count wins, and other topologies retain the upstream policy.
+    if (tasks_ == 0 && topo_.is_hybrid && topo_.p_cores == 8 && topo_.e_cores == 8) {
+        const int64_t threads = n_ + (host_works_ ? 1 : 0);
+        const int64_t want = (std::min)(6 * threads, (std::max)(threads, rows / 64));
+        return (int) (std::min)(rows, want);
+    }
+#endif
     return tasks_ == 0 ? 3 * (n_ + (host_works_ ? 1 : 0)) : (int) (std::min)(rows, (int64_t) tasks_);
 }
 
